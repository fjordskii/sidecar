# Run logs contain balances, positions, and full cycle summaries.
ops/run.log
*.log

# Session/lock artifacts from agent tooling.
.claude/*.lock
.claude/settings.local.json

# Local env / credentials — never commit broker tokens.
.env
.env.*
!.env.example

# Python build artifacts (tools/ and tests/ are the repo's first Python).
__pycache__/
*.pyc

.DS_Store
