# Run logs contain balances, positions, and full cycle summaries.
ops/run.log
*.log

# Session/lock artifacts from agent tooling.
.claude/*.lock
.claude/settings.local.json

# Local env / credentials — never commit broker tokens.
.env
.env.*
!.env.example

# The engine's private working files. bot/raw/ is verbatim broker JSON — your real
# positions, balances and order ids — and brief.md is computed from it. Neither is ever
# committed. (tools/secret_scan.py deliberately SKIPS directories named raw/, so these
# two lines are the control, not the scanner; CI separately refuses a tracked bot/raw/.)
bot/raw/
bot/brief.md

# Python build artifacts.
__pycache__/
*.pyc

.DS_Store
